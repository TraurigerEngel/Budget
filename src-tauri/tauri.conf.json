{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Бюджет",
  "version": "0.2.0",
  "identifier": "com.lostheaven.budget",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Бюджет",
        "url": "index.html",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "maximized": true,
        "decorations": false,
        "backgroundColor": "#020203",
        "devtools": true,
        "shadow": true,
        "zoomHotkeysEnabled": false,
        "limitNavigationsToAppBoundDomains": true,
        "visible": true,
        "center": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
